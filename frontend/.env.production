# Production environment variables
VITE_API_BASE_URL=https://psflzclkbl.execute-api.us-east-1.amazonaws.com/Prod

# Performance and PWA settings
VITE_ENABLE_PWA=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_IMAGE_OPTIMIZATION=true

# Service Worker settings
VITE_SW_CACHE_NAME=borrowhub-v1.0.0

# Security settings
VITE_CSP_REPORT_URI=https://psflzclkbl.execute-api.us-east-1.amazonaws.com/Prod/api/csp-report

# Analytics and monitoring
VITE_ENABLE_ANALYTICS=true