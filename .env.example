# BorrowHub Environment Configuration
# Copy this file to .env and adjust values for your environment

# Server Configuration
PORT=8080
ENVIRONMENT=development
JWT_SECRET=your-super-secret-jwt-key-change-in-production

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=borrowhub
DB_USER=borrowhub
DB_PASSWORD=password123
DB_SSLMODE=disable

# Database Connection Pool
DB_MAX_OPEN_CONNS=25
DB_MAX_IDLE_CONNS=5
DB_CONN_MAX_LIFETIME=300

# External Services
RAZORPAY_KEY=your-razorpay-key
RAZORPAY_SECRET=your-razorpay-secret

# Storage Configuration
STORAGE_TYPE=local
STORAGE_BUCKET=borrowhub-uploads
STORAGE_PATH=./uploads

# Email Configuration
EMAIL_PROVIDER=smtp
EMAIL_FROM_NAME=BorrowHub
EMAIL_FROM_ADDR=noreply@borrowhub.com
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your-email@gmail.com
SMTP_PASSWORD=your-app-password

# Security Configuration
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://borrowhubb.live
RATE_LIMIT_ENABLED=true
RATE_LIMIT_RPS=10
SESSION_TIMEOUT=1440
PASSWORD_MIN_LENGTH=8
REQUIRE_EMAIL_VERIFY=false

# Feature Flags
ENABLE_REGISTRATION=true
ENABLE_MESSAGING=true
ENABLE_RATINGS=true
MAINTENANCE_MODE=false

# Admin Configuration
ADMIN_PANEL_ENABLED=true
SUPER_ADMIN_EMAIL=admin@borrowhub.com

# AWS RDS PostgreSQL Configuration (Production):
# DB_HOST=your-rds-endpoint.region.rds.amazonaws.com
# DB_PORT=5432
# DB_NAME=borrowhub
# DB_USER=borrowhub
# DB_PASSWORD=your-secure-password
# DB_SSLMODE=require